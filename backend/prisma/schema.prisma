generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  ssoProviders  SsoProvider[]
  memberships   Membership[]
  createdShops  Shop[]    @relation("ShopCreatedBy")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                      String    @id
  accountId               String
  providerId              String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken             String?
  refreshToken            String?
  idToken                 String?
  accessTokenExpiresAt    DateTime?
  refreshTokenExpiresAt   DateTime?
  scope                   String?
  password                String?
  createdAt               DateTime
  updatedAt               DateTime

  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model SsoProvider {
  id             String   @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String   @unique
  organizationId String?
  domain         String
  createdAt      DateTime
  updatedAt      DateTime
}

model SamlProviderConfig {
  providerId            String   @id @map("provider_id")
  domains               String[]
  issuer                String
  entryPoint            String   @map("entry_point")
  entryPointBinding     String   @default("redirect") @map("entry_point_binding")
  cert                  String
  callbackUrl           String?  @map("callback_url")
  spEntityId            String?  @map("sp_entity_id")
  spPrivateKey          String?  @map("sp_private_key")
  spPrivateKeyPass      String?  @map("sp_private_key_pass")
  spMetadataXml         String?  @map("sp_metadata_xml")
  mapping               Json?
  wantAssertionsSigned  Boolean  @default(true) @map("want_assertions_signed")
  authnRequestsSigned   Boolean  @default(false) @map("authn_requests_signed")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("saml_provider_configs")
}

model Shop {
  id                  String       @id @default(cuid())
  name                String
  organization        String
  primaryContactEmail String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  createdById         String
  createdBy           User         @relation("ShopCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  memberships         Membership[]

  @@index([createdById])
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  userId    String
  shopId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
}

enum MembershipRole {
  ADMIN
  MEMBER
}
