DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fab_desk"
BETTER_AUTH_SECRET="replace-with-a-random-long-string"
# Comma-separated list of allowed browser origins for CORS/auth.
# Keep FRONTEND_ORIGIN for backwards compatibility if you only have one origin.
FRONTEND_ORIGINS="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"
PORT="3000"
# Development-only: proxy non-API requests from backend to Vite for same-origin tunnel testing.
FRONTEND_DEV_PROXY_ENABLED="true"
FRONTEND_DEV_PROXY_URL="http://localhost:5173"

# Public backend URL for auth callbacks (set this to your tunnel URL in remote testing).
# Example: "https://jack-mac.jackcrane.rocks"
BETTER_AUTH_URL="http://localhost:3000"
# Optional: bypass state cookie comparison for cross-origin SSO/OAuth callback setups.
# Keep "false" when frontend and auth callback share the same origin.
BETTER_AUTH_SKIP_STATE_COOKIE_CHECK="false"
# Optional: set auth cookies as SameSite=None; Secure for cross-origin frontend <-> auth hosts.
# Requires HTTPS.
BETTER_AUTH_CROSS_SITE_COOKIES="false"

# SAML provider config is DB-backed (table: saml_provider_configs).
# Seed/create providers with SQL, for example:
# psql "$DATABASE_URL" -f backend/sql/2026-02-26_seed_saml_provider_configs.sql
