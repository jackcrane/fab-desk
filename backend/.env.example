DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fab_desk"
BETTER_AUTH_SECRET="replace-with-a-random-long-string"
# Comma-separated list of allowed browser origins for CORS/auth.
# Keep FRONTEND_ORIGIN for backwards compatibility if you only have one origin.
FRONTEND_ORIGINS="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"
PORT="3000"
# Development-only: proxy non-API requests from backend to Vite for same-origin tunnel testing.
FRONTEND_DEV_PROXY_ENABLED="true"
FRONTEND_DEV_PROXY_URL="http://localhost:5173"

# Public backend URL for auth callbacks (set this to your tunnel URL in remote testing).
# Example: "https://jack-mac.jackcrane.rocks"
BETTER_AUTH_URL="http://localhost:3000"
# Optional: bypass state cookie comparison for cross-origin SSO/OAuth callback setups.
# Keep "false" when frontend and auth callback share the same origin.
BETTER_AUTH_SKIP_STATE_COOKIE_CHECK="false"
# Optional: set auth cookies as SameSite=None; Secure for cross-origin frontend <-> auth hosts.
# Requires HTTPS.
BETTER_AUTH_CROSS_SITE_COOKIES="false"

# Option A (recommended): define multiple SSO providers as JSON.
# - domains can be an array or comma-separated string.
# - cert/private keys can include escaped newlines (\\n).
SAML_SSO_PROVIDERS_JSON='[
  {
    "providerId": "acme-saml",
    "domains": ["acme.com", "acme.co"],
    "issuer": "",
    "entryPoint": "",
    "cert": "",
    "callbackUrl": "",
    "spEntityId": "",
    "spPrivateKey": "",
    "spPrivateKeyPass": "",
    "wantAssertionsSigned": true,
    "authnRequestsSigned": false
  }
]'

# Option B: single-provider fallback.
SAML_PROVIDER_ID=""
SAML_EMAIL_DOMAINS=""
SAML_ISSUER=""
SAML_ENTRY_POINT=""
SAML_CERT=""
SAML_CALLBACK_URL=""
SAML_SP_ENTITY_ID=""
SAML_SP_PRIVATE_KEY=""
SAML_SP_PRIVATE_KEY_PASS=""
SAML_WANT_ASSERTIONS_SIGNED="true"
SAML_AUTHN_REQUESTS_SIGNED="false"
# Optional JSON object for overriding SAML attribute mapping.
# Example: {"firstName":"firstName","lastName":"lastName","name":"displayName"}
SAML_ATTRIBUTE_MAPPING_JSON=""
